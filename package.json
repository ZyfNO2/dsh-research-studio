{
  "name": "dsh-research-studio-monorepo",
  "version": "0.1.2-alpha.1",
  "private": true,
  "description": "Academic Tailor Research Studio — Plugin layers for DeepSeek Harness",
  "type": "module",
  "scripts": {
    "build": "pnpm run build:host && pnpm run build:client",
    "build:host": "tsc -b tsconfig.host.json && tsdown --env.DSH_BUILD_FACE host",
    "build:client": "tsc -b tsconfig.client.json && tsdown --env.DSH_BUILD_FACE client",
    "test": "vitest run",
    "typecheck": "pnpm run build:host && tsc -b tsconfig.client.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "jsdom": "29.1.1",
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
